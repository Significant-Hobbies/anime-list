{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/worker.ts",
    "src/agent-edge.mjs",
    "functions/_middleware.ts",
    "functions/api/[[path]].ts",
    "functions/anime/[malId].ts",
    "functions/manga/[malId].ts"
  ],
  "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts}"],
  "ignore": [
    // Static asset loaded via a raw <script src> tag (index.html), not an import.
    "public/app-health-log.js",
    "public/footer.js",
    // Fleet's checkout-local evidence is excluded from Git and is not project source.
    ".fleet-local/**"
  ],
  "ignoreDependencies": [
    // Child-process/CLI/config-only tools and the CSS import are not visible in the module graph.
    "jscpd",
    "lightningcss",
    "pino-pretty",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreIssues": {
    // Generated agent metadata and UI primitives intentionally expose a public surface.
    "**/agent-edge.*": ["exports", "types"],
    "components/ui/**": ["exports", "types"]
  }
}
