{
  "name": "mal",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "",
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"pnpm dev:worker\" \"vite\"",
    "dev:be": "pnpm dev:worker",
    "dev:fe": "vite",
    "dev:worker": "pnpm db:migrate:local && wrangler dev --config wrangler.local.toml",
    "prebuild": "node scripts/build-seo-dataset.mjs && node scripts/build-agent-surfaces.mjs",
    "generate:agent-surfaces": "node scripts/build-agent-surfaces.mjs",
    "build": "vite build",
    "postbuild": "node scripts/build-sitemaps.mjs",
    "preview": "vite preview",
    "deploy": "node -e \"const cp=require('child_process');const branch=cp.execSync('git branch --show-current',{encoding:'utf8'}).trim();const dirty=cp.execSync('git status --porcelain',{encoding:'utf8'}).trim(); if(branch!=='main'||dirty){console.error('deploy: must be on clean main branch (current:',branch, dirty?'dirty tree':''); process.exit(1);} console.log('deploy: clean main confirmed');\" && pnpm build && wrangler pages deploy dist --project-name=anime-list --branch=main",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:anime-detail": "playwright test e2e/anime-detail.spec.ts",
    "db:migrate:local": "wrangler d1 migrations apply anime-list --local --config wrangler.local.toml",
    "db:migrate:remote": "node scripts/validate-d1-config.mjs && wrangler d1 migrations apply anime-list --remote --config wrangler.cron.toml",
    "db:prepare-import": "node scripts/prepare-d1-import.mjs",
    "db:rehearse": "tsx scripts/rehearse-d1.ts",
    "db:seed": "pnpm db:migrate:local && tsx src/scripts/seedAnimeData.ts",
    "db:seed:manga": "pnpm db:migrate:local && tsx src/scripts/seedMangaData.ts",
    "db:update": "tsx src/scripts/updateAnimeData.ts",
    "db:update:remote": "D1_REMOTE_APPROVED=true tsx src/scripts/updateAnimeData.ts --remote",
    "db:update:manga": "tsx src/scripts/updateMangaData.ts",
    "db:update:manga:remote": "D1_REMOTE_APPROVED=true tsx src/scripts/updateMangaData.ts --remote",
    "db:update:manga:full": "tsx src/scripts/updateMangaData.ts -- --full",
    "db:update:manga:full:remote": "D1_REMOTE_APPROVED=true tsx src/scripts/updateMangaData.ts --full --remote",
    "db:quarterly-sync": "tsx src/scripts/runQuarterlyAnimeSync.ts",
    "db:quarterly-sync:remote": "D1_REMOTE_APPROVED=true tsx src/scripts/runQuarterlyAnimeSync.ts --remote",
    "deploy:worker": "node scripts/validate-d1-config.mjs && pnpm db:migrate:remote && wrangler deploy src/worker.ts --config wrangler.cron.toml --tag \"$(git rev-parse HEAD)\"",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "hono": "4.12.32",
    "jose": "6.2.4",
    "lucide-react": "1.27.0",
    "nuqs": "2.9.2",
    "pino": "10.3.1",
    "posthog-js": "^1.407.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "web-vitals": "^4.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "4.20260424.1",
    "@playwright/test": "1.62.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-react-swc": "4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "9.2.1",
    "husky": "9.1.7",
    "jsdom": "^29.0.0",
    "knip": "^6.29.0",
    "lightningcss": "1.33.0",
    "pino-pretty": "13.1.3",
    "shadcn": "4.15.0",
    "size-limit": "^11.2.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.10.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.9.0"
    }
  }
}
